# QCAD MCP — Environment Configuration
# Copy to .env and adjust.

# Server transport: "stdio" (Claude Desktop) or "http" (Tauri/browser)
MCP_TRANSPORT=http
MCP_HOST=127.0.0.1
MCP_PORT=10966

# CAD depot and output directories (defaults to %LOCALAPPDATA%\qcad-mcp\depot)
# QCAD_MCP_DEPOT=C:\Users\...\qcad-mcp\depot
# QCAD_MCP_OUTPUT=C:\Users\...\qcad-mcp\output

# QCAD Pro install path override (auto-detected from Program Files)
# QCAD_PRO_PATH=C:\Program Files\QCAD\qcad.exe

# MCP bridge: comma-separated URLs to proxy other MCP servers
# MCP_BRIDGE_URLS=http://127.0.0.1:10944/mcp,http://127.0.0.1:10849/mcp

# FluidX3D path (optional, for enhanced physics simulation)
# FLUIDX3D_PATH=

# Tauri build flag (set automatically by native/build.ps1)
# QCAD_TAURI=1
