{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"files": { "includes": ["src/**/*", "e2e/**/*"] },
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"style": { "useTemplate": "off" },
			"suspicious": { "noExplicitAny": "off" }
		}
	},
	"formatter": { "enabled": true, "lineWidth": 120 },
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	}
}
